# --- Required: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used only in server actions/scripts that need to bypass RLS (seeding, admin tasks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Required in production (used for metadata, sitemap, and password-reset redirect links) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Required: your account ---
# The one email allowed to hold the OWNER role. Enforced by the handle_new_user trigger in schema.sql.
OWNER_EMAIL=you@example.com

# --- Optional: AI diary search AND Ask LifeOS (same key powers both) ---
# If unset, both the diary search box and the "Ask LifeOS" panel stay visible
# and explain the feature isn't configured yet — nothing else breaks.
ANTHROPIC_API_KEY=

# --- Optional: Spotify (manual entry is used if unset) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
